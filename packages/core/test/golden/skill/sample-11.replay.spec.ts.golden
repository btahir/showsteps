// Generated by Showsteps (https://showsteps.vercel.app) from the guide "Sign in, ask for help, and update billing in Acme Books", 11 steps.
// Run it with: npx playwright test replay.spec.ts
// Values typed into sensitive fields were never stored. Set SHOWSTEPS_SECRET_1 before running.
import { expect, test, type Page } from "@playwright/test";

test.use({ viewport: { width: 1440, height: 900 } });

test("Sign in, ask for help, and update billing in Acme Books", async ({ context }) => {
  test.skip(!process.env.SHOWSTEPS_SECRET_1, "set SHOWSTEPS_SECRET_1");
  const page = await context.newPage();
  let page2!: Page;

  await test.step("1. Go to Sign in – Acme Books", async () => {
    await page.goto("http://127.0.0.1:4517/index.html");
    await expect(page).toHaveURL(/^http:\/\/127\.0\.0\.1:4517\/index\.html\/?(?:[?#].*)?$/);
  });

  await test.step('2. Type "jane@example.com" in Email', async () => {
    await page.getByLabel("Email").fill("jane@example.com");
  });

  await test.step("3. Enter your password", async () => {
    await page.getByLabel("Password").fill(process.env.SHOWSTEPS_SECRET_1!);
  });

  await test.step("4. Click Sign in", async () => {
    await page.getByRole("button", { name: "Sign in" }).click();
  });

  await test.step("5. Click Help centre", async () => {
    [page2] = await Promise.all([context.waitForEvent("page"), page.getByRole("link", { name: "Help centre" }).click()]);
  });

  await test.step('6. Search for "invoices"', async () => {
    await page2.waitForLoadState("domcontentloaded");
    await page2.getByPlaceholder("Search help").fill("invoices");
  });

  await test.step("7. Click Reports", async () => {
    await page.bringToFront();
    await page.getByRole("link", { name: "Reports" }).click();
  });

  await test.step("8. Click Settings", async () => {
    await page.getByRole("link", { name: "Settings" }).click();
  });

  await test.step("9. Select Yearly in Billing period", async () => {
    await page.getByLabel("Billing period").selectOption({ label: "Yearly" });
  });

  await test.step("10. Check Email me invoices", async () => {
    await page.getByLabel("Email me invoices").setChecked(true);
  });

  await test.step("11. Click Save", async () => {
    await page.getByTestId("save-settings").click();
  });
});
