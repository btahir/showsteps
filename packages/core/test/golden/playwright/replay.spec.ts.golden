// Generated by Showsteps (https://showsteps.vercel.app) from the guide "Update billing settings in Acme", 10 steps.
// Run it with: npx playwright test replay.spec.ts
// Values typed into sensitive fields were never stored. Set SHOWSTEPS_SECRET_1 before running.
import { expect, test, type Page } from "@playwright/test";

test.use({ viewport: { width: 80, height: 50 } });

test("Update billing settings in Acme", async ({ context }) => {
  test.skip(!process.env.SHOWSTEPS_SECRET_1, "set SHOWSTEPS_SECRET_1");
  const page = await context.newPage();
  let page2!: Page;

  await test.step("1. Go to Sign in – Acme", async () => {
    await page.goto("https://app.acme.test/login");
    await expect(page).toHaveURL(/^https:\/\/app\.acme\.test\/login\/?(?:[?#].*)?$/);
  });

  await test.step('2. Type "jane@example.com" in Email', async () => {
    await page.getByLabel("Email").fill("jane@example.com");
  });

  await test.step("3. Enter your password", async () => {
    await page.getByLabel("Password").fill(process.env.SHOWSTEPS_SECRET_1!);
  });

  await test.step("4. Click Sign in", async () => {
    await page.getByTestId("signin-button").click();
  });

  await test.step("5. Click Open settings", async () => {
    await page.getByRole("button", { name: "Open settings" }).click();
  });

  await test.step("6. Select Monthly in Billing period", async () => {
    await page.getByLabel("Billing period").selectOption({ label: "Monthly" });
  });

  await test.step("7. Check Email me invoices", async () => {
    await page.getByLabel("Email me invoices").setChecked(true);
  });

  await test.step("8. Click Pay now", async () => {
    [page2] = await Promise.all([context.waitForEvent("page"), page.frameLocator('iframe[name="card-frame"]').getByRole("button", { name: "Pay now" }).click()]);
  });

  await test.step("9. Go to Invoices – Acme Help", async () => {
    await page2.waitForLoadState("domcontentloaded");
    await expect(page2).toHaveURL(/^https:\/\/help\.acme\.test\/invoices\/?(?:[?#].*)?$/);
  });

  await test.step("10. Press Enter to search", async () => {
    await page2.getByPlaceholder("Search help").press("Enter");
  });
});
