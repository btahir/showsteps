---
// Code-drawn illustration of a generated guide. All content is mock data.
---
<div class="mock" role="img" aria-label="Example of a Showsteps guide: step 4 types an email into the Email field with the field outlined, and a password-like field blurred; step 5 clicks Send invite with the button outlined.">
  <div class="mock-bar" aria-hidden="true"><i></i><i></i><i></i><span>Invite a teammate · 6 steps</span></div>
  <div class="mock-body" aria-hidden="true">
    <div class="mock-step">
      <h4><span class="n">4</span><span>Type "jane@example.com" in <b>Email</b></span></h4>
      <div class="mock-shot">
        <div class="mock-field">
          <label>Email</label>
          <div class="mock-input" style="outline:3px solid var(--accent);outline-offset:2px;border-radius:8px">jane@example.com</div>
        </div>
        <div class="mock-field">
          <label>Access token</label>
          <div style="position:relative">
            <div class="mock-input blur">sk_live_4f9a81c0d2</div>
            <span class="mock-tag" style="top:-9px">Blurred</span>
          </div>
        </div>
      </div>
    </div>
    <div class="mock-step">
      <h4><span class="n">5</span><span>Click <b>Send invite</b></span></h4>
      <div class="mock-shot">
        <div class="mock-two">
          <div class="mock-field"><label>Role</label><div class="mock-input">Editor</div></div>
          <div class="mock-field"><label>Team</label><div class="mock-input">Support</div></div>
        </div>
        <div class="mock-btn hl">Send invite</div>
      </div>
      <p class="mock-note">A green banner reads "Invite sent".</p>
    </div>
  </div>
</div>
