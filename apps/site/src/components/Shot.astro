---
import type { Figure } from "../data/keyword-pages";
interface Props { figure: Figure }
const { figure } = Astro.props;
---
<figure class="shot-fig">
  {figure.kind === "themed" && (
    <div class={`shot-frame ${figure.name === "editor" ? "wide" : "narrow"}`}>
      <picture>
        <source srcset={`/img/${figure.name}-dark.webp`} media="(prefers-color-scheme: dark)" />
        <img src={`/img/${figure.name}-light.webp`} alt={figure.alt} width={figure.name === "editor" ? 920 : 400} height={figure.name === "editor" ? 724 : 900} decoding="async" />
      </picture>
    </div>
  )}
  {figure.kind === "step" && (
    <div class="shot-frame wide"><img src={`/img/${figure.name}.webp`} alt={figure.alt} width="1544" height="864" decoding="async" /></div>
  )}
  {figure.kind === "blur" && (
    <div class="blur-pair">
      <div><img src="/img/blur-before.webp" alt="" width="1200" height="340" decoding="async" /><span>Before: the raw capture</span></div>
      <div><img src="/img/blur-after.webp" alt="" width="1200" height="340" decoding="async" /><span>After: the exported guide</span></div>
      <span class="sr-only">{figure.alt}</span>
    </div>
  )}
  <figcaption>{figure.caption}</figcaption>
</figure>
