---
import type { Figure } from "../data/keyword-pages";
interface Props { figure: Figure }
const { figure } = Astro.props;
---
<figure class="shot-fig">
  {figure.kind === "themed" && (
    <div class={`shot-frame ${figure.name === "editor" ? "wide" : "narrow"}`}>
      <picture>
        <source srcset={`/img/${figure.name}-dark.webp`} media="(prefers-color-scheme: dark)" />
        <img src={`/img/${figure.name}-light.webp`} alt={figure.alt} width={figure.name === "editor" ? 920 : 400} height={figure.name === "editor" ? 724 : 900} decoding="async" />
      </picture>
    </div>
  )}
  {figure.kind === "step" && (
    <div class="shot-frame wide"><img src={`/img/${figure.name}.webp`} alt={figure.alt} width="1544" height="864" decoding="async" /></div>
  )}
  {figure.kind === "blur" && (
    <div class="blur-pair">
      <div><img src="/img/privacy-before.webp" alt="A mock account page as it appeared on screen, showing a card number, tax ID, IBAN, session token and API key in plain text." width="880" height="605" decoding="async" /><span>Before: what the page showed</span></div>
      <div><img src="/img/privacy-after.png" alt="The same page in the guide: those values are replaced by dots and the Refresh button is outlined." width="880" height="605" decoding="async" /><span>After: what the guide keeps</span></div>
    </div>
  )}
  <figcaption>{figure.caption}</figcaption>
</figure>
