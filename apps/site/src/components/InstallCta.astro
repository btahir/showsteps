---
import { CHROME_STORE_URL, GITHUB_URL } from "../config/site";
interface Props { size?: "lg" | "md" }
const { size = "lg" } = Astro.props;
const cls = size === "lg" ? "btn btn-lg" : "btn";
---
<div class="cta">
  <div class="cta-row">
    <a class={`${cls} btn-primary`} href={CHROME_STORE_URL || GITHUB_URL}>{CHROME_STORE_URL ? "Add to Chrome, it's free" : "Get it on GitHub"}</a>
    <a class={`${cls} btn-secondary`} href="/sample/">See an example guide</a>
  </div>
  {!CHROME_STORE_URL && <p class="store-note">Chrome Web Store listing coming soon.</p>}
</div>
