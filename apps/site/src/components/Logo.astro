---
// Brand logo (packages/brand/logo.svg, logo-on-dark.svg); the file is copied to /public. Height is set by CSS.
interface Props { class?: string }
---
<picture class={Astro.props.class ?? "logo"}>
  <source srcset="/logo-on-dark.svg" media="(prefers-color-scheme: dark)" />
  <img src="/logo.svg" alt="Showsteps" width="284" height="64" />
</picture>
