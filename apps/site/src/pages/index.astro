---
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import Faq from "../components/Faq.astro";
import CompareTable from "../components/CompareTable.astro";
import InstallCta from "../components/InstallCta.astro";
import { SITE_DESCRIPTION, SUPPORT_URL } from "../config/site";
import { SAMPLE_SKILL_MD, SAMPLE_REPLAY_TS, LANDING_FAQ } from "../data/samples";
import { softwareApplication, faqPage } from "../data/jsonld";

const title = "Showsteps: free step-by-step guides from a click-through";
---
<Base title={title} absoluteTitle description={SITE_DESCRIPTION} path="/" jsonLd={[softwareApplication(), faqPage(LANDING_FAQ)]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>
          Do it once.<br />
          Send the <span class="ring-word">guide.<span class="ring-tab" aria-hidden="true">1</span></span>
        </h1>
        <p class="lede">
          Click through a task in Chrome. Showsteps turns every click into a numbered step with a marked-up screenshot, blurs passwords and
          card numbers, and hands you a guide you can send in a minute. The same recording becomes a skill your agent can replay.
        </p>
        <InstallCta />
        <ul class="proof">
          <li>Stays on your computer</li>
          <li>PDF, Word, Markdown</li>
          <li>No account</li>
        </ul>
      </div>
      <div class="stage">
        <div class="stage-guide">
          <div class="stage-head"><span class="flag-num">2</span><span>Type “jane@example.com” in <b>Email</b></span></div>
          <picture>
            <source srcset="/img/sample-step-email-crop.webp" media="(max-width: 600px)" width="605" height="378" />
            <img src="/img/sample-step-email.webp" width="1544" height="864" alt="A step from an exported guide: the Email field of a sign-in form outlined with a numbered tab, and the password field below it masked." fetchpriority="high" />
          </picture>
        </div>
        <picture class="stage-panel">
          <source srcset="/img/panel-guide-dark.webp" media="(prefers-color-scheme: dark)" />
          <img src="/img/panel-guide-light.webp" width="800" height="1800" alt="The Showsteps side panel listing the steps of the guide." />
        </picture>
      </div>
    </div>
  </section>

  <section class="section sunk" id="how">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Record, review, send</h2>
      </div>
      <ol class="steps3 shots3">
        <li>
          <h3>Record</h3>
          <p>Press Record and do the task the way you normally would, across as many tabs as it takes. Pause whenever you need to.</p>
          <picture class="panel-crop">
            <source srcset="/img/panel-recording-dark.webp" media="(prefers-color-scheme: dark)" />
            <img src="/img/panel-recording-light.webp" width="800" height="1800" alt="The side panel while recording." loading="lazy" />
          </picture>
        </li>
        <li>
          <h3>Review</h3>
          <p>Every step has a screenshot and a plain title such as Click <b>Save</b>. Rewrite a title, merge or delete steps, add a note, draw a blur.</p>
          <picture class="panel-crop">
            <source srcset="/img/panel-guide-dark.webp" media="(prefers-color-scheme: dark)" />
            <img src="/img/panel-guide-light.webp" width="800" height="1800" alt="The side panel listing the recorded steps." loading="lazy" />
          </picture>
        </li>
        <li>
          <h3>Send</h3>
          <p>Send a PDF, a single HTML file, Markdown or a DOCX. Or export the agent skill and let something else do the clicking.</p>
          <picture class="panel-crop">
            <source srcset="/img/panel-export-dark.webp" media="(prefers-color-scheme: dark)" />
            <img src="/img/panel-export-light.webp" width="800" height="1800" alt="The export sheet with the format choices." loading="lazy" />
          </picture>
        </li>
      </ol>
      <p class="formats" aria-label="Export formats"><span>PDF</span><span>HTML</span><span>Markdown</span><span>DOCX</span><span>SKILL.md</span><span>.showsteps</span></p>
      <p style="margin-top:28px"><a href="/sample/">See an example guide</a>, exported by Showsteps from a recording of a mock app.</p>
    </div>
  </section>

  <section class="section" id="privacy">
    <div class="wrap promise">
      <div class="section-head" style="margin:0">
        <span class="eyebrow">Privacy</span>
        <h2>Your screenshots stay on your computer</h2>
        <p>
          Guides about internal tools contain customer names, account numbers and URLs. Showsteps has no server to send them to.{" "}
          <a href="/privacy/">Read the details</a>.
        </p>
      </div>
      <ul class="checklist">
        <li><strong>No upload.</strong> Screenshots and text live in your browser until you export a file.</li>
        <li><strong>No account.</strong> No sign-up, no email address, no login.</li>
        <li><strong>No analytics.</strong> None in the extension, none on this site.</li>
        <li><strong>Passwords are not recorded.</strong> Password and card fields are detected, their values are never saved, and the screenshot is blurred.</li>
        <li><strong>No network after install.</strong> The extension does not phone home.</li>
        <li><strong>Readable source.</strong> MIT licensed, and the file format is documented.</li>
      </ul>
    </div>
    <div class="wrap">
      <figure class="blur-fig">
        <div class="blur-pair">
          <div><img src="/img/privacy-before.webp" alt="A mock account page as it appeared on screen, showing a card number, tax ID, IBAN, session token and API key in plain text." width="880" height="605" loading="lazy" /><span>Before: what the page showed</span></div>
          <div><img src="/img/privacy-after.png" alt="The same page in the guide: those values are replaced by dots and the Refresh button is outlined." width="880" height="605" loading="lazy" /><span>After: what the guide keeps</span></div>
        </div>
        <figcaption>A mock account page as it appeared on screen, and the same step as the guide keeps it. Card numbers, tax IDs, IBANs, session tokens and API keys are found on the page and masked before the screenshot is stored, so the original never reaches the guide. Fake data throughout.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section sunk" id="agents">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">For agents</span>
        <h2>One recording, two audiences</h2>
        <p>
          You get a guide. Your coding agent gets a skill: numbered steps in <code>SKILL.md</code>, a machine-readable
          <code>steps.json</code> and a Playwright <code>replay.spec.ts</code> that prefers role, label and test-id locators.
          Agents can also drive Showsteps from the command line or a local MCP server.
        </p>
      </div>
      <div class="code-pair">
        <Code code={SAMPLE_SKILL_MD} caption="SKILL.md" maxLines={16} />
        <Code code={SAMPLE_REPLAY_TS} caption="replay.spec.ts" maxLines={16} />
      </div>
      <p style="margin-top:20px"><a href="/docs/agents/">CLI and MCP usage for agents</a> · <a href="/convert-clicks-to-playwright-test/">Convert clicks to a Playwright test</a> · <a href="/record-workflow-as-agent-skill/">Record a workflow as an agent skill</a></p>
    </div>
  </section>

  <section class="section" id="compare">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Compared</span>
        <h2>Showsteps, Mimik, Scribe and Tango</h2>
        <p>Scribe and Tango do things we do not: desktop capture, hosted links, team workspaces. Mimik is a free, local option that also exports video and GIF. If you need those, use them. If you want a guide you own, plus a script an agent can run, here is the difference.</p>
      </div>
      <CompareTable />
      <p style="margin-top:20px"><a href="/open-source-scribe-alternative/">Open-source Scribe alternative, with Mimik compared</a> · <a href="/tango-alternative/">A Tango alternative</a> · <a href="/scribe-alternative-no-cloud-upload/">Without cloud upload</a></p>
    </div>
  </section>

  <section class="section sunk" id="faq">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">FAQ</span><h2>Questions people ask first</h2></div>
      <Faq items={LANDING_FAQ} />
    </div>
  </section>

  <section class="section" id="install">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:24px">
        <h2>Get Showsteps</h2>
        <p>Scribe puts PDF export and redaction on a plan it lists at $35 a month. Showsteps does both for nothing, and keeps your screenshots to itself.</p>
      </div>
      <InstallCta />
      <p style="margin-top:22px;color:var(--ink-2)">
        It stays free because people chip in. If it saves you time, <a href={SUPPORT_URL}>support Showsteps</a>.
      </p>
    </div>
  </section>
</Base>
