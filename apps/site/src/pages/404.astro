---
import Base from "../layouts/Base.astro";
import { KEYWORD_PAGES } from "../data/keyword-pages";
---
<Base title="Page not found" description="That page isn't here." path="/404/" noindex>
  <div class="wrap">
    <div class="page-head">
      <span class="eyebrow">404</span>
      <h1>That page isn't here.</h1>
      <p class="lede">The link may be old or mistyped. These will get you back on track.</p>
      <div style="margin-top:24px" class="cta-row">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-secondary" href="/sample/">See an example guide</a>
      </div>
    </div>
    <div class="prose-wrap">
      <div class="prose">
        <h2 style="margin-top:0">Guides</h2>
        <ul>
          {KEYWORD_PAGES.map((p) => <li><a href={`/${p.slug}/`}>{p.label}</a></li>)}
          <li><a href="/docs/agents/">Showsteps for agents</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </div>
  </div>
</Base>
